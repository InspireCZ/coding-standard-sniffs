{
    "type": "phpcodesniffer-standard",
    "name": "inspirecz/coding-standard-sniffs",
    "description": "INSPIRE Coding Standard Sniffs",
    "license": "MIT",
    "keywords": [
        "coding standard",
        "php",
        "coding",
        "standard"
    ],
    "require": {
        "php": ">=8.3",
        "squizlabs/php_codesniffer": "^4"
    },
    "require-dev": {
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpunit/phpunit": "^12.0"
    },
    "authors": [
        {
            "name": "INSPIRE CZ s.r.o.",
            "email": "firma@inspire.cz",
            "homepage": "https://www.inspire.cz/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Inspire\\": "Inspire/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inspire\\": "tests/"
        }
    },
    "scripts": {
        "lint": "php8.3 vendor/bin/parallel-lint Inspire",
        "test": "php8.3 vendor/bin/phpunit",
        "qa": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        }
    }
}
